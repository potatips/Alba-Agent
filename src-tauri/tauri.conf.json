{
  "productName": "Alba Agent",
  "version": "0.1.0",
  "identifier": "com.albaagent.desktop",
  "build": {
    "beforeDevCommand": "pnpm --prefix ./web dev",
    "beforeBuildCommand": "pnpm --prefix ./web build",
    "frontendDist": "../web/out"
  },
  "app": {
    "windows": [
      {
        "title": "Alba Agent",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
